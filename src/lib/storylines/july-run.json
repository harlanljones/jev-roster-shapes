		{
			"id": "mlb-stats-api-2026",
			"title": "MLB Stats API — Red Sox season-timeline snapshot, as of 2026-06-30",
			"kind": "projection",
			"effectiveAt": "2026-06-30T00:00:00Z",
			"note": "Free public endpoints, fetched 2026-09-25T23:22:14Z into spikes/mlb-2026/timeline-snapshot.json. Rates are observed 2026 regular-season totals from 2026-03-01 through 2026-06-30 (what was known on the decision date); for traded players the combined all-teams row is used. Eligibility: >= 10 fielding games at a position in 2025 or >= 10 Boston starts there in 2026 through 2026-06-30 (D-35 rule, adapted), or >= 3 starts there in Boston's starting lineups from 2026-06-01 to 2026-07-31; DH excluded. Boston starts only: a traded player's starts for another club do not count toward the 2026 rule. Use of page content acknowledges the MLBAM copyright notice. Rates are observed R/PA, not forward projections; splits unavailable."
		},
		{
			"id": "storyline-assumptions",
			"title": "Observed batting-order pattern · illustrative 10-game allocation",
			"kind": "manual",
			"effectiveAt": "2026-06-30T00:00:00Z",
			"note": "PA demand is scaled from one observed nine-inning Boston–Pittsburgh game on 2026-08-14: 39 PA across the nine starting slots (5 each for batting orders 1–3; 4 each for orders 4–9). Applied to four left-starter-context games and six right-starter-context games: top three slots receive 20/30 PA per context; remaining slots receive 16/24. L/R exposure is an illustrative 25/75 split assumption, not measured context data. This is not a team planning horizon or forecast. Workload caps remain generous placeholders (O-02). Baseline lineups are the club’s observed starting lineups for the storyline’s window. Source box score: https://www.baseball-almanac.com/box-scores/boxscore.php?boxid=202608140PIT"
		}
	],
