{
	"name": "roster-shapes",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": ">=26.7.0 <27",
		"bun": ">=1.4.2 <2"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"setup:browsers": "playwright install chromium",
		"verify": "bun run check && bun run lint && bun run test && bun run build && bun run test:e2e"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@fontsource/ibm-plex-sans": "5.3.0",
		"@fontsource/saira-stencil-one": "5.3.0",
		"@noble/hashes": "2.4.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/node": "26.6.2",
		"@vitest/browser-playwright": "5.0.1",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-boundaries": "7.2.0",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"playwright": "1.63.0",
		"prettier": "3.9.8",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"vite": "8.3.0",
		"vitest": "5.0.1",
		"vitest-browser-svelte": "3.1.0"
	}
}
